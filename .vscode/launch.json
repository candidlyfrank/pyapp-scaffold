{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach Django",
      "type": "python",
      "request": "attach",
      "connect": { "host": "localhost", "port": 5678 },
      "pathMappings": [{ "localRoot": "${workspaceFolder}/src/django", "remoteRoot": "/app" }]
    },
    {
      "name": "Attach FastAPI",
      "type": "python",
      "request": "attach",
      "connect": { "host": "localhost", "port": 5679 },
      "pathMappings": [{ "localRoot": "${workspaceFolder}/src/fastapi", "remoteRoot": "/app" }]
    }
  ]
}
