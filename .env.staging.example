ENV=staging
DEBUG=0
LOG_LEVEL=INFO
DJANGO_SECRET_KEY=replace-in-staging-secret-store
DJANGO_ALLOWED_HOSTS=staging.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.example.com
DJANGO_DATABASE_URL=postgresql://django_app:replace-me@postgres-django:5432/django_app
DJANGO_SETTINGS_MODULE=app.settings
PYTHONPATH=/app
FASTAPI_DATABASE_URL=postgresql://fastapi_app:replace-me@postgres-fastapi:5432/fastapi_app
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=https://staging.example.com
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
