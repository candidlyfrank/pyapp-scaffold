ENV=production
DEBUG=0
LOG_LEVEL=INFO
DJANGO_SECRET_KEY=load-from-secret-manager
DJANGO_ALLOWED_HOSTS=example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
DJANGO_DATABASE_URL=postgresql://django_app:load-from-secret-manager@postgres-django:5432/django_app
DJANGO_SETTINGS_MODULE=app.settings
PYTHONPATH=/app
FASTAPI_DATABASE_URL=postgresql://fastapi_app:load-from-secret-manager@postgres-fastapi:5432/fastapi_app
REDIS_URL=redis://redis:6379/0
CORS_ALLOWED_ORIGINS=https://example.com
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
DJANGO_IMAGE=ghcr.io/owner/repo-django:sha
FASTAPI_IMAGE=ghcr.io/owner/repo-fastapi:sha
